@model Formio.Models.Forms

@{
    ViewData["Title"] = "Form render";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap/dist/css/bootstrap.min.css">
<script src="https://cdn.form.io/js/formio.embed.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="container mt-5">
    <h3>@Model.Title</h3>

    <div id="formioRender" class="border rounded bg-light p-3"></div>
   
    <script>
        debugger
             $(document).ready(function(){
            Formio.createForm(document.getElementById('formioRender'), @Html.Raw(Model.FormFields))
                .then(function (form) {
                    form.on('submit', function (submission) {
                        console.log('Form submitted:', submission.data);

                        $.ajax({
                            url: '/Admin/Submission/FormSubmissionAsync',

                            type: 'POST',
                            data: {
                                FormId: '@Model.Id',
                                SubmissionData: JSON.stringify(submission.data),
                                
                            },
                            success: function (res) {
                                alert(res.message);
                            },
                            error: function (xhr) {
                                console.log(xhr.responseText);
                                alert("Something went wrong!");
                            }
                        });
                    });
                });
        });
           
    </script>




</div>