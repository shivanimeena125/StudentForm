@model IEnumerable<FormSubmissionExtended>

@{
    ViewData["Title"] = "All Form Submissions";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.form.io/js/formio.full.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="container mt-4">
    <h2>All Form Submissions</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Form Title</th>
                <th>Submitted By</th>
                <th>Submitted On</th>
                <th>View</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-form-id="@item.FormId">
                    <td>@item.FormTitle</td>
                    <td>@item.SubmittedUserName</td>
                    <td>@item.SubmittedUtc.ToString("g")</td>
                    <td>
                        <button class="btn btn-primary btn-sm view-btn"
                                data-json='@Html.Raw(item.SubmissionData)'
                                data-formid="@item.FormId">
                            View
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h4 class="mt-4">Form Preview</h4>
    <div id="formio-preview" class="border rounded bg-light p-3"></div>
</div>

<script>
    $(document).ready(function () {
        $(".view-btn").click(function () {
            const jsonData = $(this).data("json");         // submitted form data
            const formId = $(this).data("formid");         // related form id

            // Clear previous content
            document.getElementById("formio-preview").innerHTML = "";

            // Fetch form structure from backend
           fetch("/Admin/Submission/GetFormSchema/" + formId)

                .then(response => response.json())
                .then(formSchema => {
                    Formio.createForm(document.getElementById("formio-preview"), formSchema)
                        .then(form => {
                            form.submission = { data: jsonData };
                            form.disabled = true; // make it read-only
                        });
                })
                .catch(error => {
                    console.error("Error loading form:", error);
                    alert("Unable to load form.");
                });
        });
    });
</script>

