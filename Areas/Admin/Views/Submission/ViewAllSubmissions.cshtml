@model IEnumerable<FormSubmissionExtended>

@{
    ViewData["Title"] = "All Form Submissions";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2> Submissions</h2>
    <div>
        <input type="text" id="searchForm" name="Title" class="form-control mb-3" placeholder="Search by title..." />
    </div>
    <table class="table table-bordered table-striped"id="submissionTable">
        <thead>
            <tr>
                <th>Form Title</th>
                <th>Submitted By</th>
                <th>Submitted On</th>
                <th class="col-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FormTitle</td>
                    <td>@item.SubmittedUserName</td>
                    <td>@item.SubmittedUtc.ToString("g")</td>
                    <td>
                        <a class="btn btn-primary btn-sm"
                           asp-area="Admin"
                           asp-controller="Submission"
                           asp-action="ViewSubmission"
                           asp-route-formId="@item.FormId"
                           asp-route-submissionData="@Html.Raw(Uri.EscapeDataString(item.SubmissionData))">
                            View
                        </a>
                        <a class="btn btn-warning btn-sm"
                           asp-area="Admin"
                           asp-controller="Submission"
                           asp-action="EditSubmission"
                           asp-route-formId="@item.FormId"
                           asp-route-submissionData="@Html.Raw(Uri.EscapeDataString(item.SubmissionData))">
                            Edit
                        </a>
                        <button class="btn btn-danger btn-sm delete-btn"
                                data-formid="@item.FormId"
                                data-userid="@item.SubmittedBy"
                                data-date="@item.SubmittedUtc">
                            Delete
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<script>
    const isAdmin = @User.IsInRole("Admin").ToString().ToLower(); 
    $(document).ready(function () {
        $('#submissionTable').DataTable({
      
        $(".view-btn").click(function () {
            const jsonData = $(this).data("json");         
            const formId = $(this).data("formid");       

          
            document.getElementById("formio-preview").innerHTML = "";
            const schemaUrl = isAdmin === "true"
             ? "/Admin/Submission/GetFormSchema/" + formId
              : "/Home/GetFormSchema/" + formId;
            
           fetch("/Admin/Submission/GetFormSchema/" + formId)

                .then(response => response.json())
                .then(formSchema => {
                    Formio.createForm(document.getElementById("formio-preview"), formSchema)
                        .then(form => {
                            form.submission = { data: jsonData };
                            form.disabled = true; 
                        });
                })
                .catch(error => {
                    console.error("Error loading form:", error);
                    alert("Unable to load form.");
                });
        });
    
        $(".delete-btn").click(function () {
        if (!confirm("Are you sure you want to delete this submission?")) return;

        const formId = $(this).data("formid");
        const userId = $(this).data("userid");
        const submittedUtc = $(this).data("date");

        fetch(`/Admin/Submission/DeleteSubmission?formId=${formId}&userId=${userId}&submittedUtc=${submittedUtc}`, {
            method: "POST"
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert("Delete failed.");
            }
        });
    });
     });
    });
</script>