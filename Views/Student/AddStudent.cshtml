        //         }
        //     }

        //     Next button
        //     if (currentPage < totalPages) {
        //         paginationHtml += `<button onclick="loadStudents(${currentPage + 1})">Next</button>`;
        //     }

        //             $("#paginationBtn").html(paginationHtml);
        // }

//========================================================================================================================
//sdit delete button ke liye ajax        
function bindRowEvents() {
            $(".editBtn").off().on("click", function () {
                const studentId = $(this).data("id");

                $.get('/Student/GetStudentById', { id: studentId }, function (student) {
                    if (student) {
                        $("input[name='Student.Id']").val(student.id);
                        $("input[name='Student.FirstName']").val(student.firstName);
                        $("input[name='Student.LastName']").val(student.lastName);
                        $("input[name='Student.Class']").val(student.class);
                        $("input[name='Student.Gender'][value='" + student.gender + "']").prop("checked", true);
                        $("input[name='Student.Address']").val(student.address);
                        $("select[name='Student.CityId']").val(student.cityId);

                        $("#submitbtn").val("Update");
                    }
                });
            });

            $(".deleteBtn").off().on("click", function () {
                const studentId = $(this).data("id");
                const row = $(this).closest("tr");

                if (confirm("Do you really want to delete this student?")) {
                    $.post('/Student/DeleteStudent', { id: studentId }, function (response) {
                        alert(response.message);
                        if (response.success) {
                            row.remove();
                        }
                    });
                }
            });
        }

        //========================================================================================================================
                // Load countries, states cities for filtering
                        $(document).ready(function () {
          
            $.get('/City/GetAllCountries', function (data) {
                data.forEach(country => {
                    $("#filterCountry").append(`<option value="${country.countryName}">${country.countryName}</option>`);
                });
            });

            $("#filterCountry").change(function () {
                const countryName = $(this).val();
                $("#filterState").html('<option value="">-- Select State --</option>');
                $("#filterCity").html('<option value="">-- Select City --</option>');

                if (countryName) {
                            $.get('/City/GetAllCountries', function (countries) {
                        const country = countries.find(c => c.countryName === countryName);
                        if (country) {
                                    $.get('/City/GetStatesByCountryId?countryId=' + country.id, function (states) {
                                states.forEach(state => {
                                    $("#filterState").append(`<option value="${state.stateName}">${state.stateName}</option>`);
                                });
                            });
                        }
                    });
                }
            });

            $("#filterState").change(function () {
                const stateName = $(this).val();
                $("#filterCity").html('<option value="">-- Select City --</option>');

                const countryName = $("#filterCountry").val();
                if (stateName && countryName) {
                            $.get('/City/GetAllCountries', function (countries) {
                        const country = countries.find(c => c.countryName === countryName);
                        if (country) {
                                    $.get('/City/GetStatesByCountryId?countryId=' + country.id, function (states) {
                                const state = states.find(s => s.stateName === stateName);
                                if (state) {
                                            $.get('/City/GetCitiesByStateId?stateId=' + state.id, function (cities) {
                                        cities.forEach(city => {
                                            $("#filterCity").append(`<option value="${city.cityName}">${city.cityName}</option>`);
                                        });
                                    });
                                }
                            });
                        }
                    });
                }
            });

            $("#filterCity").change(function () {
                loadStudents(); 
            });
        });
        //=====================================================================================================
        //country, state city dropdwoun ke liye
                $(document).ready(function () {
                    $.get('/City/GetAllCountries', function (countries) {
                countries.forEach(c => {
                    $("#countryDropdown").append(`<option value="${c.id}">${c.countryName}</option>`);
                });
            });

       
            $("#countryDropdown").change(function () {
                const countryId = $(this).val();
                $("#stateDropdown").html('<option value="">-- Select State --</option>');
                $("#cityDropdown").html('<option value="">-- Select City --</option>');

                if (countryId) {
                            $.get(`/City/GetStatesByCountryId?countryId=${countryId}`, function (states) {
                        states.forEach(s => {
                            $("#stateDropdown").append(`<option value="${s.id}">${s.stateName}</option>`);
                        });
                    });
                }
            });

            $("#stateDropdown").change(function () {
                const stateId = $(this).val();
                $("#cityDropdown").html('<option value="">-- Select City --</option>');

                if (stateId) {
                            $.get(`/City/GetCitiesByStateId?stateId=${stateId}`, function (cities) {
                        cities.forEach(c => {
                            $("#cityDropdown").append(`<option value="${c.id}">${c.cityName}</option>`);
                        });
                    });
                }
            });
        });

    </script>
}
