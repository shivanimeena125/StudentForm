        //     Previous button
        //     if (currentPage > 1) {
        //         paginationHtml += `<button onclick="loadStudents(${currentPage - 1})">Previous</button>`;
        //     }

        //     Page numbers
        //     for (let i = 1; i <= totalPages; i++) {
        //         if (i === currentPage) {
        //             paginationHtml += `<button disabled>${i}</button>`;
        //         } else {
        //             paginationHtml += `<button onclick="loadStudents(${i})">${i}</button>`;
        //         }
        //     }

        //     Next button
        //     if (currentPage < totalPages) {
        //         paginationHtml += `<button onclick="loadStudents(${currentPage + 1})">Next</button>`;
        //     }

        //             $("#paginationBtn").html(paginationHtml);
        // }

//========================================================================================================================
        function bindRowEvents() {
            $(".editBtn").off().on("click", function () {
                const studentId = $(this).data("id");

                $.get('/Student/GetStudentById', { id: studentId }, function (student) {
                    if (student) {
                        $("input[name='Student.Id']").val(student.id);
                        $("input[name='Student.FirstName']").val(student.firstName);
                        $("input[name='Student.LastName']").val(student.lastName);
                        $("input[name='Student.Class']").val(student.class);
                        $("input[name='Student.Gender'][value='" + student.gender + "']").prop("checked", true);
                        $("input[name='Student.Address']").val(student.address);

                        $("#submitbtn").val("Update");
                    }
                });
            });

            $(".deleteBtn").off().on("click", function () {
                const studentId = $(this).data("id");
                const row = $(this).closest("tr");

                if (confirm("Do you really want to delete this student?")) {
                    $.post('/Student/DeleteStudent', { id: studentId }, function (response) {
                        alert(response.message);
                        if (response.success) {
                            row.remove();
                        }
                    });
                }
            });
        }
    </script>
}
