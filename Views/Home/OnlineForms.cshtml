
@model List<Formio.Models.ViewFormModel>
@{
    ViewData["Title"] = "online forms";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Online Forms</h2>

    <ul class="list-group list-group-flush shadow-sm rounded">
        @foreach (var form in Model)
        {
             <li class="list-group-item  px-4 py-3">

                <a asp-controller="Form" asp-action="ViewForm" asp-route-formGroupId="@form.FormGroupId" >
                    @form.Title
                </a>
            </li>
        }
    </ul>
</div>
