@model IEnumerable<FormSubmissionExtended>

@{
    ViewData["Title"] = "All Form Submissions";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2> Submissions</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Form Title</th>
                <th>Submitted By</th>
                <th>Submitted On</th>
                <th class="col-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FormTitle</td>
                    <td>@item.SubmittedUserName</td>
                    <td>@item.SubmittedUtc.ToString("g")</td>
                    <td>
                        <a class="btn btn-primary btn-sm"
                           asp-area="Admin"
                           asp-controller="Submission"
                           asp-action="ViewSubmission"
                           asp-route-formId="@item.FormId"
                           asp-route-submissionData="@Html.Raw(Uri.EscapeDataString(item.SubmissionData))">
                            View
                        </a>
                        @* <a class="btn btn-warning btn-sm">Edit</a>
                        <button class="btn btn-danger btn-sm">Delete</button> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<script>
    const isAdmin = @User.IsInRole("Admin").ToString().ToLower(); 
    $(document).ready(function () {
        $(".view-btn").click(function () {
            const jsonData = $(this).data("json");         
            const formId = $(this).data("formid");       

          
            document.getElementById("formio-preview").innerHTML = "";
            const schemaUrl = isAdmin === "true"
             ? "/Admin/Submission/GetFormSchema/" + formId
              : "/Home/GetFormSchema/" + formId;
            
           fetch( "/Home/GetFormSchema/" + formId)

                .then(response => response.json())
                .then(formSchema => {
                    Formio.createForm(document.getElementById("formio-preview"), formSchema)
                        .then(form => {
                            form.submission = { data: jsonData };
                            form.disabled = true; 
                        });
                })
                .catch(error => {
                    console.error("Error loading form:", error);
                    alert("Unable to load form.");
                });
        });
    });
</script>