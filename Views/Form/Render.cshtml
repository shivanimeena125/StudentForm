@model Formio.Models.Forms
@{
    ViewData["Title"] = "Render Form";
}

<script src="https://cdn.form.io/formio.full.min.js"></script>
<link rel="stylesheet" href="https://cdn.form.io/formio.full.min.css" />

<h2>@Model.Title</h2>
<div id="form-render"></div>

<script>
    const formJson = @Html.Raw(Model.FormFields);

    Formio.createForm(document.getElementById('form-render'), formJson).then(function(form) {
        form.on('submit', function(submission) {
            console.log('Form submitted:', submission.data);
            alert("Form submitted! Check console for output.");
        });
    });
</script>
